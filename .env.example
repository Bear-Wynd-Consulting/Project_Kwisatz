# =============================================================================
# Project_Kwisatz — Ollama API Gateway Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Generate API keys with:
#   bash scripts/generate-api-key.sh
# =============================================================================

# --- Authentication (REQUIRED) -----------------------------------------------
# Comma-separated list of valid API keys.
# Assign one key per WRP app for independent revocation.
# Example: key_opennotebook_xxx,key_propertytour_xxx,key_propmgmt_xxx
API_KEYS=REPLACE_WITH_KEY_FOR_OPEN_NOTEBOOK,REPLACE_WITH_KEY_FOR_PROPERTY_TOUR,REPLACE_WITH_KEY_FOR_PROPERTY_MGMT

# --- CORS (REQUIRED) ---------------------------------------------------------
# Comma-separated list of allowed origins. Never use * in production.
# Example: http://localhost:3000,https://app.yourcompany.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# --- Ollama ------------------------------------------------------------------
# Internal service URL — do not change unless you rename the compose service
OLLAMA_BASE_URL=http://ollama:11434

# Ollama model tag to serve. Verify the exact tag at https://ollama.com/library
# Gemma 4 variants (choose based on available RAM):
#   gemma4:latest   — latest Gemma 4 (check Ollama hub for available tags)
#   gemma3:27b      — ~18GB RAM required
#   gemma3:12b      — ~7GB RAM required
#   gemma3:4b       — ~3GB RAM required
DEFAULT_MODEL=gemma4:latest

# --- Rate Limiting -----------------------------------------------------------
# Global limit across all keys combined
RATE_LIMIT_GLOBAL=200/minute

# Per-key limit (applied per API key, not per IP)
RATE_LIMIT_PER_KEY=60/minute

# --- Gateway -----------------------------------------------------------------
GATEWAY_PORT=8000

# Number of Uvicorn worker processes (set to 1 for GPU inference to avoid
# multiple processes competing for VRAM)
UVICORN_WORKERS=2

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
